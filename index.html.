<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>FamilyHub — Prototype Keluarga</title>
<style>
:root{--blue:#1769e8;--blue2:#eaf2ff;--ink:#18243a;--muted:#718096;--line:#e6ebf2;--bg:#f5f8fc;--green:#19a66a;--white:#fff;--shadow:0 8px 26px rgba(26,48,82,.07)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0}.app{min-height:100vh;display:grid;grid-template-columns:245px 1fr}.sidebar{background:#fff;border-right:1px solid var(--line);padding:22px 15px;display:flex;flex-direction:column;gap:22px}.brand{display:flex;align-items:center;gap:10px;padding:0 8px}.logo{width:39px;height:39px;background:var(--blue);border-radius:13px;color:white;display:grid;place-items:center;font-size:22px;font-weight:800}.brand b{font-size:18px}.brand small{display:block;color:var(--muted);font-size:11px}.nav{display:grid;gap:5px}.nav button{background:transparent;text-align:left;padding:11px 12px;border-radius:10px;color:#56647a;display:flex;gap:12px;align-items:center}.nav button.active,.nav button:hover{background:var(--blue2);color:var(--blue);font-weight:700}.nav .ico{width:19px;text-align:center;font-size:17px}.sidebottom{margin-top:auto;border-top:1px solid var(--line);padding:14px 5px 0;display:flex;gap:10px;align-items:center}.avatar{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:#dce9ff;color:#2059b3;font-weight:800;flex-shrink:0}.avatar.green{background:#d9f6e8;color:#13734b}.avatar.pink{background:#ffe3ed;color:#a73b69}.avatar.gold{background:#fff0cf;color:#946310}.sidebottom small,.muted{color:var(--muted)}main{min-width:0;padding:25px 28px 40px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:24px}.eyebrow{font-size:12px;color:var(--muted)}h1{font-size:26px;line-height:1.2;margin:3px 0 5px;letter-spacing:-.6px}h2{font-size:17px;margin:0 0 14px}h3{font-size:14px;margin:0 0 6px}.top-actions{display:flex;gap:9px;align-items:center}.pill{border-radius:999px;padding:7px 11px;background:#fff;border:1px solid var(--line);color:#58677d}.primary{background:var(--blue);color:#fff;border-radius:9px;padding:10px 14px;font-weight:700}.secondary{background:#fff;border:1px solid var(--line);color:#34445e;border-radius:9px;padding:9px 12px}.danger{background:#fff0f0;color:#ba3838;border-radius:9px;padding:9px 12px}.grid{display:grid;gap:16px}.stats{grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:18px}.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:var(--shadow);min-width:0}.stat{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}.stat .big{font-size:25px;font-weight:800;margin-top:6px}.stat .symbol{width:39px;height:39px;border-radius:12px;background:var(--blue2);color:var(--blue);display:grid;place-items:center;font-size:19px}.maincols{grid-template-columns:minmax(0,1.35fr) minmax(280px,.8fr)}.members{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.member{border:1px solid var(--line);border-radius:13px;padding:13px;display:flex;align-items:center;gap:10px}.member .details{min-width:0}.member strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.member small{color:var(--muted)}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);margin-right:5px}.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.quick button{background:#f7faff;border:1px solid #e6efff;border-radius:12px;padding:15px 7px;color:#285ba7}.quick span{display:block;font-size:22px;margin-bottom:5px}.activity{display:grid;gap:14px}.activityrow{display:flex;align-items:flex-start;gap:11px}.activityrow p{margin:0}.activityrow small{display:block;color:var(--muted);margin-top:3px}.mapfake{height:320px;position:relative;overflow:hidden;border-radius:14px;border:1px solid #dbe7f3;background-color:#edf4ef;background-image:linear-gradient(32deg,transparent 46%,#fff 47%,#fff 49%,transparent 50%),linear-gradient(120deg,transparent 43%,#fff 44%,#fff 46%,transparent 47%),linear-gradient(0deg,transparent 48%,#d4e6d5 49%,#d4e6d5 53%,transparent 54%);background-size:160px 140px,190px 180px,100% 100%}.mapfake:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 68px,rgba(255,255,255,.75) 69px 73px),repeating-linear-gradient(0deg,transparent 0 52px,rgba(255,255,255,.7) 53px 57px);opacity:.75}.maplabel{position:absolute;z-index:1;background:#fff;padding:9px 12px;border-radius:11px;box-shadow:var(--shadow);display:flex;gap:8px;align-items:center;font-size:12px}.maplabel small{display:block;color:var(--muted)}.pin{position:absolute;z-index:2;width:16px;height:16px;border:4px solid white;border-radius:50%;background:var(--blue);box-shadow:0 0 0 4px #1769e833}.chatlayout{display:grid;grid-template-columns:260px 1fr;min-height:500px}.chatlist{border-right:1px solid var(--line);padding-right:14px}.chatperson{display:flex;gap:10px;align-items:center;padding:12px;border-radius:10px;cursor:pointer}.chatperson.active,.chatperson:hover{background:#eef5ff}.chatwindow{padding:0 0 0 18px;display:flex;flex-direction:column;min-width:0}.messages{display:flex;flex-direction:column;gap:12px;flex:1;padding:15px 0}.bubble{max-width:78%;padding:10px 13px;border-radius:13px;background:#f0f3f8;align-self:flex-start}.bubble.mine{align-self:flex-end;background:#e4efff}.bubble small{display:block;color:var(--muted);font-size:10px;margin-top:4px}.sendrow{display:flex;gap:8px;border-top:1px solid var(--line);padding-top:14px}.sendrow input{flex:1;min-width:0;border:1px solid var(--line);border-radius:10px;padding:11px}.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.field{display:grid;gap:6px}.field label{font-size:12px;color:#66758a;font-weight:700}.field input,.field select,.field textarea{width:100%;border:1px solid #dce3ed;border-radius:9px;padding:11px;background:white;color:var(--ink)}.role{padding:5px 8px;background:#edf3ff;color:#245bb2;border-radius:99px;font-size:11px}.tablewrap{overflow:auto}table{border-collapse:collapse;width:100%;min-width:540px}th,td{text-align:left;padding:13px 10px;border-bottom:1px solid var(--line)}th{color:var(--muted);font-size:12px;font-weight:700}td{font-size:13px}.toggle{width:38px;height:22px;background:#ccd5e2;border-radius:99px;position:relative;display:inline-block;vertical-align:middle}.toggle:after{content:"";position:absolute;width:16px;height:16px;top:3px;left:3px;border-radius:50%;background:#fff;transition:.2s}.toggle.on{background:var(--blue)}.toggle.on:after{left:19px}.notice{padding:12px 14px;border-radius:11px;background:#fff8e8;color:#7c5c12;border:1px solid #f6e7bc;font-size:12px}.hidden{display:none!important}.page{display:none}.page.active{display:block}.empty{padding:35px;text-align:center;color:var(--muted)}.footerhint{font-size:11px;color:var(--muted);margin-top:16px}.mobiletop{display:none}
@media(max-width:1050px){.app{grid-template-columns:205px 1fr}.stats{grid-template-columns:repeat(2,1fr)}.members{grid-template-columns:repeat(2,1fr)}.maincols{grid-template-columns:1fr}.quick{grid-template-columns:repeat(4,1fr)}}
@media(max-width:700px){.app{display:block}.sidebar{position:fixed;z-index:5;bottom:0;left:0;right:0;height:67px;padding:5px 7px;border-right:0;border-top:1px solid var(--line);display:block}.brand,.sidebottom{display:none}.nav{display:flex;justify-content:space-around;gap:1px}.nav button{flex:1;justify-content:center;flex-direction:column;gap:1px;padding:7px 2px;font-size:10px}.nav .ico{font-size:17px}.nav button span:last-child{white-space:nowrap}.nav button:nth-child(n+6){display:none}main{padding:19px 14px 90px}.topbar{align-items:flex-start}.top-actions .pill{display:none}h1{font-size:23px}.stats{gap:10px}.card{padding:14px}.stat .big{font-size:22px}.maincols{grid-template-columns:1fr}.members{grid-template-columns:1fr}.quick{grid-template-columns:repeat(2,1fr)}.chatlayout{grid-template-columns:1fr}.chatlist{border:0;padding:0 0 12px;border-bottom:1px solid var(--line)}.chatwindow{padding:14px 0 0}.formgrid{grid-template-columns:1fr}.mapfake{height:270px}.hide-mobile{display:none}.mobiletop{display:block}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
 <div class="brand"><div class="logo">⌂</div><div><b>FamilyHub</b><small>Ruang Keluarga Digital</small></div></div>
 <nav class="nav" id="nav">
  <button class="active" data-page="home"><span class="ico">⌂</span><span>Beranda</span></button>
  <button data-page="location"><span class="ico">⌖</span><span>Peta & Lokasi</span></button>
  <button data-page="messages"><span class="ico">▤</span><span>Pesan</span></button>
  <button data-page="calls"><span class="ico">▣</span><span>Panggilan</span></button>
  <button data-page="members"><span class="ico">♧</span><span>Anggota Keluarga</span></button>
  <button data-page="activity"><span class="ico">◷</span><span>Aktivitas</span></button>
  <button data-page="settings"><span class="ico">⚙</span><span>Pengaturan</span></button>
  <button data-page="profile"><span class="ico">◉</span><span>Profil Saya</span></button>
 </nav>
 <div class="sidebottom"><div class="avatar">AA</div><div><b id="sideName">Akbar Alamsyah</b><small id="sideRole">Orang Tua</small></div></div>
</aside>
<main>
<header class="topbar"><div><div class="eyebrow">Sabtu, 17 Oktober 2026</div><h1 id="pageTitle">Selamat datang, Akbar 👋</h1><div class="muted" id="pageSubtitle">Keluarga selalu dekat, meski sedang tidak berkumpul.</div></div><div class="top-actions"><span class="pill">🔔 <span id="notifCount">2</span></span><button class="primary" onclick="openInvite()">＋ Undang anggota</button></div></header>

<section class="page active" id="page-home">
 <div class="grid stats">
  <div class="card stat"><div><div class="muted">Anggota keluarga</div><div class="big" id="statMembers">5</div><small class="muted">Dalam ruang keluarga</small></div><div class="symbol">♧</div></div>
  <div class="card stat"><div><div class="muted">Sedang online</div><div class="big" id="statOnline">3</div><small class="muted">Status yang dibagikan</small></div><div class="symbol">◉</div></div>
  <div class="card stat"><div><div class="muted">Pesan belum dibaca</div><div class="big" id="statMessages">2</div><small class="muted">Dari keluarga</small></div><div class="symbol">▤</div></div>
  <div class="card stat"><div><div class="muted">Berbagi lokasi</div><div class="big">3/5</div><small class="muted">Dengan izin anggota</small></div><div class="symbol">⌖</div></div>
 </div>
 <div class="grid maincols">
  <div class="grid" style="gap:16px">
   <div class="card"><div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px"><h2>Anggota keluarga</h2><button class="secondary" onclick="go('members')">Lihat semua →</button></div><div class="members" id="homeMembers"></div></div>
   <div class="card"><h2>Akses cepat</h2><div class="quick">
    <button onclick="go('messages')"><span>▤</span>Chat keluarga</button><button onclick="go('calls')"><span>▣</span>Panggilan</button><button onclick="go('location')"><span>⌖</span>Lokasi</button><button onclick="openInvite()"><span>＋</span>Tambah anggota</button>
   </div></div>
   <div class="card"><h2>Aktivitas terbaru</h2><div class="activity" id="homeActivity"></div></div>
  </div>
  <div class="grid" style="align-content:start;gap:16px">
   <div class="card"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px"><h2>Lokasi terbaru</h2><button class="secondary" onclick="go('location')">Buka peta</button></div><div class="activity" id="locationList"></div><div class="notice" style="margin-top:14px">🔒 Lokasi hanya terlihat jika anggota mengaktifkan berbagi lokasi.</div></div>
   <div class="card"><h2>Jam di lokasi anggota</h2><div class="grid" style="grid-template-columns:repeat(2,1fr);gap:12px"><div><small class="muted">Jakarta</small><div class="big" style="font-size:22px;font-weight:800" id="clockJakarta">17:43</div><small class="muted">WIB · UTC+7</small></div><div><small class="muted">Bali</small><div class="big" style="font-size:22px;font-weight:800" id="clockBali">17:43</div><small class="muted">WITA · UTC+8</small></div></div></div>
  </div>
 </div>
</section>

<section class="page" id="page-location">
 <div class="grid maincols"><div class="card"><div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px"><h2>Peta keluarga</h2><select id="locationFilter" class="pill" onchange="renderMap()"><option value="all">Semua anggota</option><option>Chio</option><option>Rani</option><option>Akbar Alamsyah</option></select></div><div class="mapfake" id="mapFake"><span class="maplabel" style="left:7%;top:13%">📍 <span><b>Chio</b><small>Sekolah · 2 menit lalu</small></span></span><span class="maplabel" style="right:7%;top:42%">📍 <span><b>Rani</b><small>Rumah · 5 menit lalu</small></span></span><span class="maplabel" style="left:23%;bottom:13%">📍 <span><b>Akbar</b><small>Petukangan Selatan</small></span></span><i class="pin" style="left:51%;top:49%"></i></div><p class="muted" style="font-size:12px;margin:10px 0 0">Peta ilustrasi untuk prototype, bukan posisi GPS sebenarnya.</p></div>
 <div class="card"><h2>Kontrol berbagi lokasi</h2><div class="activity"><div class="activityrow"><div class="avatar">AA</div><div style="flex:1"><b>Lokasi saya</b><small class="muted">Dibagikan kepada keluarga</small></div><span class="toggle on" role="switch" tabindex="0" onclick="toggleSwitch(this,'Lokasi saya')"></span></div><div class="activityrow"><div class="avatar green">C</div><div style="flex:1"><b>Chio</b><small class="muted">Berbagi lokasi aktif (contoh)</small></div><span class="toggle on" role="switch" tabindex="0" onclick="toggleSwitch(this,'Chio')"></span></div><div class="activityrow"><div class="avatar pink">R</div><div style="flex:1"><b>Rani</b><small class="muted">Berbagi lokasi aktif (contoh)</small></div><span class="toggle" role="switch" tabindex="0" onclick="toggleSwitch(this,'Rani')"></span></div></div><div class="notice" style="margin-top:18px">Lokasi real-time memerlukan izin perangkat, koneksi internet, dan layanan peta saat website dikembangkan.</div></div></div>
</section>

<section class="page" id="page-messages">
 <div class="card chatlayout"><div class="chatlist"><h2>Pesan keluarga</h2><input style="width:100%;padding:10px;border:1px solid var(--line);border-radius:9px;margin-bottom:9px" placeholder="Cari percakapan…" oninput="filterChats(this.value)"><div id="chatContacts"></div></div><div class="chatwindow"><div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><div><h2 id="chatTitle">Keluarga Besar</h2><small class="muted">Percakapan keluarga · Prototype</small></div><button class="secondary" onclick="go('calls')">▣ Panggil</button></div><div class="messages" id="messagesBox"></div><form class="sendrow" id="sendForm"><input id="messageInput" placeholder="Tulis pesan untuk keluarga…" autocomplete="off"><button class="primary">Kirim</button></form><div class="footerhint">Demo lokal: pesan hanya tersimpan sementara di halaman ini.</div></div></div>
</section>

<section class="page" id="page-calls">
 <div class="grid maincols"><div class="card"><h2>Panggilan keluarga</h2><div style="background:#152239;border-radius:15px;color:white;padding:35px 18px;text-align:center;min-height:290px;display:flex;flex-direction:column;align-items:center;justify-content:center"><div class="avatar" style="width:78px;height:78px;font-size:28px;margin-bottom:13px">👨‍👩‍👧</div><h2 style="margin:0 0 5px;color:white" id="callStatus">Siap terhubung?</h2><p style="color:#c7d3e7;margin:0 0 20px">Pilih simulasi panggilan di bawah</p><div style="display:flex;gap:12px"><button class="primary" onclick="startCall('Suara')">☎ Panggilan suara</button><button class="primary" style="background:#25885d" onclick="startCall('Video')">▣ Panggilan video</button></div><button class="danger" style="margin-top:14px" onclick="endCall()">Akhiri panggilan</button></div></div><div class="card"><h2>Fitur komunikasi</h2><div class="activity"><div class="activityrow"><div class="symbol">🎙️</div><div><b>Pesan suara (VN)</b><small class="muted">Antarmuka contoh; rekaman belum diaktifkan.</small></div></div><div class="activityrow"><div class="symbol">📷</div><div><b>Foto dan video</b><small class="muted">Upload media perlu penyimpanan backend.</small></div></div><div class="activityrow"><div class="symbol">🔒</div><div><b>Privasi panggilan</b><small class="muted">Panggilan nyata memerlukan layanan komunikasi dan izin perangkat.</small></div></div></div></div></div>
</section>

<section class="page" id="page-members">
 <div class="card"><div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:15px"><div><h2 style="margin-bottom:4px">Anggota keluarga</h2><div class="muted">Atur peran dan akses sesuai kebutuhan.</div></div><button class="primary" onclick="openInvite()">＋ Tambah anggota</button></div><div class="tablewrap"><table><thead><tr><th>Anggota</th><th>Email</th><th>Peran</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="memberRows"></tbody></table></div><div class="footerhint">Perubahan peran di prototype hanya tersimpan di sesi browser ini, bukan akun online.</div></div>
 <div class="card" style="margin-top:16px"><h2>Undang keluarga</h2><p class="muted">Buat tautan undangan untuk dibagikan secara pribadi. Anggota baru harus menerima undangan dan diverifikasi.</p><div style="display:flex;gap:10px;flex-wrap:wrap"><button class="secondary" onclick="generateInvite()">Buat tautan undangan</button><input id="inviteLink" readonly placeholder="Tautan undangan muncul di sini" style="flex:1;min-width:180px;border:1px solid var(--line);border-radius:9px;padding:10px"><button class="secondary" onclick="copyInvite()">Salin</button></div></div>
</section>

<section class="page" id="page-activity">
 <div class="card"><h2>Aktivitas keluarga</h2><p class="muted">Contoh aktivitas yang dibagikan anggota; bukan pelacakan diam-diam.</p><div class="activity" id="activityFull"></div></div>
</section>

<section class="page" id="page-settings">
 <div class="grid maincols"><div class="card"><h2>Peran & hak akses</h2><div class="tablewrap"><table><thead><tr><th>Fitur</th><th>Orang tua</th><th>Dewasa</th><th>Anak</th><th>Saudara</th></tr></thead><tbody><tr><td>Melihat lokasi yang dibagikan</td><td>✓</td><td>✓</td><td>Terbatas</td><td>Opsional</td></tr><tr><td>Kelola anggota</td><td>✓</td><td>Opsional</td><td>—</td><td>—</td></tr><tr><td>Chat & media</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td></tr><tr><td>Ubah izin anak</td><td>✓</td><td>Opsional</td><td>—</td><td>—</td></tr><tr><td>Kelola keamanan</td><td>✓</td><td>Opsional</td><td>—</td><td>—</td></tr></tbody></table></div><div class="notice" style="margin-top:14px">Hak akses final dapat disesuaikan. Peran tidak boleh digunakan untuk mengakses lokasi tanpa izin atau melanggar privasi.</div></div><div class="card"><h2>Privasi & keamanan</h2><div class="activity"><label><input type="checkbox" checked> Minta persetujuan sebelum berbagi lokasi</label><label><input type="checkbox" checked> Tampilkan kapan lokasi terakhir diperbarui</label><label><input type="checkbox" checked> Batasi riwayat aktivitas sesuai peran</label><label><input type="checkbox"> Kirim notifikasi saat anggota bergabung</label></div><button class="primary" style="margin-top:18px" onclick="toast('Preferensi demo disimpan.')">Simpan preferensi</button></div></div>
</section>

<section class="page" id="page-profile">
 <div class="card" style="max-width:760px"><h2>Profil saya</h2><div style="display:flex;align-items:center;gap:14px;margin-bottom:20px"><div class="avatar" style="width:65px;height:65px;font-size:21px" id="profileAvatar">AA</div><div><b id="profileNameLabel">Akbar Alamsyah</b><div class="muted" id="profileEmailLabel">akbar@gmail.com</div><label class="secondary" style="display:inline-block;margin-top:7px;cursor:pointer">Pilih foto<input type="file" accept="image/*" id="photoUpload" style="display:none"></label></div></div><form id="profileForm" class="formgrid"><div class="field"><label>Nama lengkap</label><input id="profileName" value="Akbar Alamsyah" required></div><div class="field"><label>Email (Gmail)</label><input id="profileEmail" type="email" value="akbar@gmail.com" required></div><div class="field"><label>Peran keluarga</label><select id="profileRole"><option>Orang Tua</option><option>Dewasa</option><option>Anak</option><option>Saudara</option><option>Anggota lainnya</option></select></div><div class="field"><label>Zona waktu</label><select><option>Asia/Jakarta (WIB)</option><option>Asia/Makassar (WITA)</option><option>Asia/Jayapura (WIT)</option></select></div><div class="field" style="grid-column:1/-1"><label>Tentang saya</label><textarea rows="3" placeholder="Ceritakan sedikit tentang diri Anda…"></textarea></div><div><button class="primary">Simpan perubahan</button></div></form><div class="notice" style="margin-top:18px">Login Google dan perubahan profil sungguhan memerlukan autentikasi serta database. Form ini adalah simulasi interaktif.</div></div>
</section>
<div class="footerhint">FamilyHub Prototype • Antarmuka demo • Tidak menggunakan GPS atau mengirim pesan sungguhan.</div>
</main></div>

<div id="modal" class="hidden" style="position:fixed;inset:0;z-index:10;background:#15223977;display:grid;place-items:center;padding:18px"><div class="card" style="width:min(500px,100%);box-shadow:0 25px 80px #0e203955"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:15px"><h2 id="modalTitle">Tambah anggota</h2><button class="secondary" onclick="closeModal()">✕</button></div><form id="inviteForm" class="grid" style="gap:12px"><div class="field"><label>Nama anggota</label><input id="newName" required placeholder="Contoh: Tante Maya"></div><div class="field"><label>Email</label><input id="newEmail" type="email" required placeholder="nama@gmail.com"></div><div class="field"><label>Peran keluarga</label><select id="newRole"><option>Orang Tua</option><option>Dewasa</option><option>Anak</option><option>Saudara</option><option>Anggota lainnya</option></select></div><div class="field"><label>Hak berbagi lokasi</label><select id="newLocation"><option>Meminta persetujuan</option><option>Berbagi lokasi</option><option>Tidak berbagi lokasi</option></select></div><div style="display:flex;gap:8px;justify-content:flex-end;margin-top:6px"><button type="button" class="secondary" onclick="closeModal()">Batal</button><button class="primary">Tambah anggota</button></div></form></div></div>
<div id="toast" style="position:fixed;bottom:85px;left:50%;transform:translateX(-50%);background:#17253b;color:white;padding:11px 16px;border-radius:10px;box-shadow:var(--shadow);display:none;z-index:20;max-width:90%;text-align:center"></div>
<script>
const members=[
 {name:"Akbar Alamsyah",email:"akbar@gmail.com",role:"Orang Tua",status:"Online",loc:"Petukangan Selatan",initial:"AA",tone:""},
 {name:"Ibu",email:"ibu@gmail.com",role:"Orang Tua",status:"Online",loc:"Rumah",initial:"I",tone:"pink"},
 {name:"Chio",email:"chio@gmail.com",role:"Anak",status:"Di sekolah",loc:"Sekolah",initial:"C",tone:"green"},
 {name:"Rani",email:"rani@gmail.com",role:"Anak",status:"Online",loc:"Rumah",initial:"R",tone:"pink"},
 {name:"Kakek",email:"kakek@gmail.com",role:"Dewasa",status:"Offline",loc:"Lokasi tidak dibagikan",initial:"K",tone:"gold"}
];
let activities=[
 ["C","Chio membagikan status lokasi","2 menit lalu","green"],
 ["R","Rani mengirim foto ke grup Keluarga","12 menit lalu","pink"],
 ["AA","Akbar memperbarui profil","1 jam lalu",""],
 ["K","Kakek mengirim pesan","2 jam lalu","gold"]
];
let conversations={"Keluarga Besar":[["Ibu","Kita makan di rumah ya 🍲","16:20",false],["Akbar","Oke, nanti aku kabari kalau sudah dekat.","16:22",true],["Rani","Aku juga ikut 😊","16:24",false]],"Chio":[["Chio","Ayah, aku sudah sampai sekolah.","07:28",false],["Akbar","Oke, semangat belajarnya ya!","07:30",true]],"Ibu":[["Ibu","Tolong beli buah kalau pulang ya.","16:45",false]],"Rani":[["Rani","Aku sudah di rumah.","15:30",false]],"Grup Kegiatan":[["Akbar","Rencana kumpul hari Minggu.","Kemarin",true]]};
let activeChat="Keluarga Besar";
const titles={home:["Selamat datang, Akbar 👋","Keluarga selalu dekat, meski sedang tidak berkumpul."],location:["Peta & Lokasi Keluarga","Lihat lokasi yang dibagikan dengan izin."],messages:["Pesan keluarga","Terhubung melalui percakapan pribadi dan grup."],calls:["Panggilan keluarga","Simulasi antarmuka suara dan video."],members:["Anggota keluarga","Kelola siapa saja yang ada di ruang keluarga."],activity:["Aktivitas keluarga","Aktivitas yang dibagikan di ruang keluarga."],settings:["Pengaturan keluarga","Atur peran, akses, dan privasi."],profile:["Profil saya","Kelola informasi akun dan preferensi." ]};
function go(page){document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));document.getElementById("page-"+page).classList.add("active");document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.page===page));document.getElementById("pageTitle").textContent=titles[page][0];document.getElementById("pageSubtitle").textContent=titles[page][1];if(page==="members")renderMembers();if(page==="messages")renderChats();if(page==="activity")renderActivity("activityFull");window.scrollTo({top:0,behavior:"smooth"})}
document.getElementById("nav").addEventListener("click",e=>{const b=e.target.closest("button[data-page]");if(b)go(b.dataset.page)});
function avatar(m){return `<div class="avatar ${m.tone||""}">${m.initial||m.name.slice(0,1).toUpperCase()}</div>`}
function renderHome(){document.getElementById("homeMembers").innerHTML=members.slice(0,6).map(m=>`<div class="member">${avatar(m)}<div class="details"><strong>${esc(m.name)}</strong><small><span class="dot" style="background:${m.status==="Offline"?"#b6c0ce":"var(--green)"}"></span>${esc(m.status)}</small></div></div>`).join("");document.getElementById("statMembers").textContent=members.length;document.getElementById("statOnline").textContent=members.filter(m=>m.status!=="Offline").length;renderActivity("homeActivity");document.getElementById("locationList").innerHTML=members.filter(m=>m.loc!=="Lokasi tidak dibagikan").slice(0,3).map(m=>`<div class="activityrow">${avatar(m)}<div style="flex:1"><b>${esc(m.name)}</b><small>${esc(m.loc)}</small></div><span class="role">${m.status==="Offline"?"Offline":"Aktif"}</span></div>`).join("")}
function renderMembers(){document.getElementById("memberRows").innerHTML=members.map((m,i)=>`<tr><td><div style="display:flex;align-items:center;gap:9px">${avatar(m)}<b>${esc(m.name)}</b></div></td><td>${esc(m.email)}</td><td><select aria-label="Ubah peran ${esc(m.name)}" onchange="changeRole(${i},this.value)" class="pill">${["Orang Tua","Dewasa","Anak","Saudara","Anggota lainnya"].map(r=>`<option ${m.role===r?"selected":""}>${r}</option>`).join("")}</select></td><td><span class="role">${esc(m.status)}</span></td><td><button class="secondary" onclick="editMember(${i})">Edit</button> ${i>0?`<button class="danger" onclick="removeMember(${i})">Hapus</button>`:""}</td></tr>`).join("")}
function changeRole(i,role){members[i].role=role;toast("Peran "+members[i].name+" diubah menjadi "+role+".");renderMembers();renderHome()}
function editMember(i){const m=members[i];document.getElementById("newName").value=m.name;document.getElementById("newEmail").value=m.email;document.getElementById("newRole").value=m.role;document.getElementById("modalTitle").textContent="Edit anggota";document.getElementById("inviteForm").dataset.edit=i;document.getElementById("modal").classList.remove("hidden")}
function removeMember(i){if(confirm("Hapus "+members[i].name+" dari daftar prototype?")){members.splice(i,1);renderMembers();renderHome();toast("Anggota dihapus dari demo.")}}
function openInvite(){document.getElementById("modalTitle").textContent="Tambah anggota";document.getElementById("inviteForm").reset();delete document.getElementById("inviteForm").dataset.edit;document.getElementById("modal").classList.remove("hidden")}
function closeModal(){document.getElementById("modal").classList.add("hidden")}
document.getElementById("inviteForm").addEventListener("submit",e=>{e.preventDefault();let i=document.getElementById("inviteForm").dataset.edit;let name=document.getElementById("newName").value.trim(),email=document.getElementById("newEmail").value.trim(),role=document.getElementById("newRole").value,loc=document.getElementById("newLocation").value;let obj={name,email,role,status:"Undangan",loc:loc==="Berbagi lokasi"?"Menunggu izin": "Lokasi tidak dibagikan",initial:name.split(/\s+/).map(x=>x[0]).slice(0,2).join("").toUpperCase(),tone:""};if(i!==undefined){members[+i]={...members[+i],name,email,role};}else{members.push(obj);activities.unshift([obj.initial,name+" ditambahkan ke ruang keluarga","Baru",""]);}closeModal();renderMembers();renderHome();toast(i!==undefined?"Data anggota diperbarui.":"Anggota ditambahkan ke prototype.")});
function generateInvite(){document.getElementById("inviteLink").value="https://familyhub.example/invite/"+Math.random().toString(36).slice(2,10);toast("Tautan demo dibuat. Belum aktif di internet.")}
function copyInvite(){const v=document.getElementById("inviteLink").value;if(!v){toast("Buat tautan undangan terlebih dahulu.");return}if(navigator.clipboard){navigator.clipboard.writeText(v).then(()=>toast("Tautan disalin."),()=>toast(v))}else toast(v)}
function renderActivity(id){document.getElementById(id).innerHTML=activities.map(a=>`<div class="activityrow"><div class="avatar ${a[3]}">${a[0]}</div><div><p>${esc(a[1])}</p><small>${esc(a[2])}</small></div></div>`).join("")}
function renderChats(){document.getElementById("chatContacts").innerHTML=Object.keys(conversations).map(n=>`<div class="chatperson ${activeChat===n?"active":""}" onclick="selectChat('${n.replace(/'/g,"\\'")}')"><div class="avatar">${n==="Keluarga Besar"?"👨‍👩‍👧":n[0]}</div><div style="min-width:0"><b>${esc(n)}</b><small class="muted" style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc((conversations[n].slice(-1)[0]||[])[1]||"Mulai percakapan")}</small></div></div>`).join("");document.getElementById("chatTitle").textContent=activeChat;document.getElementById("messagesBox").innerHTML=(conversations[activeChat]||[]).map(m=>`<div class="bubble ${m[3]?"mine":""}">${esc(m[1])}<small>${esc(m[0])} · ${esc(m[2])}</small></div>`).join("");document.getElementById("messagesBox").scrollTop=99999}
function selectChat(n){activeChat=n;renderChats()}
function filterChats(v){document.querySelectorAll(".chatperson").forEach(c=>c.style.display=c.textContent.toLowerCase().includes(v.toLowerCase())?"flex":"none")}
document.getElementById("sendForm").addEventListener("submit",e=>{e.preventDefault();let inp=document.getElementById("messageInput"),v=inp.value.trim();if(!v)return;(conversations[activeChat]||(conversations[activeChat]=[])).push(["Akbar",v,new Date().toLocaleTimeString("id-ID",{hour:"2-digit",minute:"2-digit"}),true]);activities.unshift(["AA","Akbar mengirim pesan ke "+activeChat,"Baru",""]);inp.value="";renderChats();renderActivity("homeActivity");toast("Pesan demo ditambahkan.")});
function startCall(type){document.getElementById("callStatus").textContent="Simulasi panggilan "+type.toLowerCase()+" dimulai";toast("Ini hanya simulasi; panggilan sungguhan belum terhubung.")}
function endCall(){document.getElementById("callStatus").textContent="Panggilan berakhir";toast("Simulasi panggilan berakhir.")}
function renderMap(){const val=document.getElementById("locationFilter").value;document.querySelectorAll(".maplabel").forEach(el=>el.style.opacity=val==="all"||el.textContent.includes(val)?"1":".18")}
function toggleSwitch(el,name){el.classList.toggle("on");toast("Preferensi lokasi demo untuk "+name+" diperbarui.")}
function toast(s){const t=document.getElementById("toast");t.textContent=s;t.style.display="block";clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>t.style.display="none",2600)}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
document.getElementById("profileForm").addEventListener("submit",e=>{e.preventDefault();const n=document.getElementById("profileName").value.trim(),em=document.getElementById("profileEmail").value.trim(),r=document.getElementById("profileRole").value;document.getElementById("sideName").textContent=n;document.getElementById("sideRole").textContent=r;document.getElementById("profileNameLabel").textContent=n;document.getElementById("profileEmailLabel").textContent=em;document.getElementById("profileAvatar").textContent=n.split(/\s+/).map(x=>x[0]).slice(0,2).join("").toUpperCase();members[0].name=n;members[0].email=em;members[0].role=r;members[0].initial=n.split(/\s+/).map(x=>x[0]).slice(0,2).join("").toUpperCase();renderHome();toast("Profil demo diperbarui.")});
document.getElementById("photoUpload").addEventListener("change",e=>{const f=e.target.files[0];if(f){const url=URL.createObjectURL(f);document.getElementById("profileAvatar").style.backgroundImage=`url(${url})`;document.getElementById("profileAvatar").style.backgroundSize="cover";document.getElementById("profileAvatar").textContent="";toast("Foto profil diterapkan untuk sesi demo.")}});
function updateClocks(){const now=new Date();document.getElementById("clockJakarta").textContent=new Intl.DateTimeFormat("id-ID",{timeZone:"Asia/Jakarta",hour:"2-digit",minute:"2-digit",hour12:false}).format(now);document.getElementById("clockBali").textContent=new Intl.DateTimeFormat("id-ID",{timeZone:"Asia/Makassar",hour:"2-digit",minute:"2-digit",hour12:false}).format(now)}
renderHome();renderMembers();renderChats();renderActivity("activityFull");updateClocks();setInterval(updateClocks,30000);
</script>
</body></html>