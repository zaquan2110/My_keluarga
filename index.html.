
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>STOGRA STORE | Gaming Marketplace</title>
<meta name="description" content="STOGRA STORE - Digital gaming marketplace.">
<style>
:root{
  --bg:#080b12;--panel:#111827;--line:#263247;
  --text:#f4f7ff;--muted:#9ba9bd;
  --purple:#8b5cf6;--cyan:#22d3ee;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--bg);color:var(--text);
  font-family:Arial,Helvetica,sans-serif;
}
button,input,textarea{font:inherit}
button,a{cursor:pointer}
a{color:inherit;text-decoration:none}
.wrap{width:min(1120px,92%);margin:auto}
header{
  display:flex;align-items:center;justify-content:space-between;
  gap:20px;padding:20px 0;border-bottom:1px solid #ffffff12;
}
.logo{font-size:23px;font-weight:900;letter-spacing:-1px}
.logo span{color:var(--cyan)}
nav{display:flex;gap:20px;color:#c3ccdb;font-size:14px}
.btn{
  display:inline-block;border:0;border-radius:10px;
  padding:12px 16px;background:linear-gradient(120deg,var(--purple),#526cf5);
  color:white;font-weight:bold;
}
.btn.alt{background:#202a3b;border:1px solid var(--line)}
.hero{text-align:center;padding:75px 0 45px}
.eyebrow{font-size:12px;letter-spacing:2px;color:var(--cyan);font-weight:bold}
h1{font-size:clamp(38px,7vw,68px);letter-spacing:-3px;line-height:1.05;margin:20px auto;max-width:850px}
.gradient{
  background:linear-gradient(90deg,#b19aff,var(--cyan));
  color:transparent;background-clip:text;
}
.hero p{max-width:600px;margin:0 auto 25px;color:var(--muted);line-height:1.8}
.stats{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:28px}
.stat{padding:12px 15px;border:1px solid var(--line);border-radius:12px;color:#cbd5e1;font-size:13px}
.section{padding:32px 0 60px}
.section-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:22px}
.section-head h2{margin:0;font-size:27px}
.muted{color:var(--muted);font-size:14px;line-height:1.7}
.search{
  width:100%;padding:14px;background:#101725;color:white;
  border:1px solid var(--line);border-radius:12px;margin-bottom:18px;
}
.filters{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:22px}
.filter{
  background:#111827;border:1px solid var(--line);color:#cbd5e1;
  padding:9px 13px;border-radius:20px;
}
.filter.active{background:#49317d;border-color:#8b5cf6;color:white}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{
  overflow:hidden;background:linear-gradient(145deg,#141c2a,#0d121c);
  border:1px solid var(--line);border-radius:18px;transition:.2s;
}
.card:hover{transform:translateY(-4px);border-color:#8069db}
.art{
  height:155px;display:grid;place-items:center;font-size:55px;
  background:radial-gradient(circle at center,#41366d,#171c32 70%);
}
.card-body{padding:18px}
.tag{font-size:11px;color:#b7c5d9;border:1px solid #35435a;padding:5px 8px;border-radius:20px}
.card h3{font-size:17px;margin:15px 0 7px}
.price{font-size:21px;font-weight:900;margin:16px 0}
.card-actions{display:flex;gap:8px}
.card-actions button{flex:1;font-size:12px}
.banner{
  display:flex;align-items:center;justify-content:space-between;gap:20px;
  padding:25px;border-radius:18px;border:1px solid #5946a2;
  background:linear-gradient(120deg,#251d49,#102635);
}
.banner h2{margin-top:0}
footer{border-top:1px solid #ffffff12;padding:25px 0;color:var(--muted);font-size:13px}
.modal{
  display:none;position:fixed;inset:0;z-index:10;
  background:#000b;align-items:center;justify-content:center;padding:20px;
}
.modal.show{display:flex}
.modal-box{
  width:min(500px,100%);max-height:85vh;overflow:auto;
  background:#111827;border:1px solid var(--line);border-radius:18px;padding:24px;
}
.close{float:right;background:#263247;border:0;color:white;padding:7px 11px;border-radius:8px}
.field{width:100%;padding:12px;margin:8px 0 14px;background:#080d16;border:1px solid var(--line);color:white;border-radius:9px}
#chat-log{height:240px;overflow:auto;background:#080d16;padding:12px;border-radius:10px;margin:14px 0}
.chat-msg{padding:10px;margin:7px 0;border-radius:9px;background:#1b2638;line-height:1.5;font-size:14px}
.chat-msg.user{background:#35245d}
.cart-line{padding:12px 0;border-bottom:1px solid var(--line)}
.empty{padding:25px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:14px}
@media(max-width:760px){
  nav{gap:10px;font-size:12px}
  nav a:nth-child(2){display:none}
  .grid{grid-template-columns:1fr}
  .hero{padding-top:55px}
  .section-head{align-items:flex-start;flex-direction:column}
  .banner{align-items:flex-start;flex-direction:column}
  h1{letter-spacing:-2px}
}
</style>
</head>
<body>

<header class="wrap">
  <a class="logo" href="#">STO<span>GRA</span> STORE</a>
  <nav>
    <a href="#produk">Produk</a>
    <a href="#fitur">Keunggulan</a>
    <a href="#bantuan">Bantuan</a>
  </nav>
  <button class="btn" onclick="openCart()">🛒 <span id="cart-count">0</span></button>
</header>

<main>
<section class="hero wrap">
  <div class="eyebrow">✦ DIGITAL GAMING MARKETPLACE</div>
  <h1>Level up your game.<br><span class="gradient">Level up your world.</span></h1>
  <p>
    Selamat datang di STOGRA STORE. Temukan produk digital,
    aset gaming, dan layanan komunitas dalam satu tempat.
  </p>
  <a href="#produk" class="btn">Jelajahi Produk →</a>
  <button class="btn alt" onclick="openAI()">Tanya Staff AI ✨</button>
  <div class="stats">
    <div class="stat">⚡ Praktis dan simpel</div>
    <div class="stat">🎮 Gaming community</div>
    <div class="stat">💬 Customer support</div>
  </div>
</section>

<section class="section wrap" id="produk">
  <div class="section-head">
    <div>
      <div class="eyebrow">KOLEKSI TOKO</div>
      <h2>Produk pilihan</h2>
      <p class="muted">Cari produk favoritmu di STOGRA STORE.</p>
    </div>
    <span class="tag">DIGITAL STORE</span>
  </div>

  <input class="search" id="search" placeholder="🔎 Cari produk..." oninput="renderProducts()">

  <div class="filters">
    <button class="filter active" onclick="setFilter('Semua',this)">Semua</button>
    <button class="filter" onclick="setFilter('Game',this)">Game</button>
    <button class="filter" onclick="setFilter('Tools',this)">Tools</button>
    <button class="filter" onclick="setFilter('Layanan',this)">Layanan</button>
  </div>

  <div class="grid" id="product-grid"></div>
</section>

<section class="section wrap" id="fitur">
  <div class="banner">
    <div>
      <h2>Butuh bantuan memilih produk?</h2>
      <p class="muted">Staff STOGRA siap membantu menjelaskan katalog dan informasi toko.</p>
    </div>
    <button class="btn" onclick="openAI()">Tanya Staff AI ↗</button>
  </div>
</section>

<section class="section wrap" id="bantuan">
  <div class="section-head">
    <div>
      <div class="eyebrow">CUSTOMER SERVICE</div>
      <h2>Perlu bantuan?</h2>
      <p class="muted">Hubungi toko melalui WhatsApp atau Discord resmi.</p>
    </div>
  </div>
  <p class="muted">Ganti nomor WhatsApp dan tautan Discord pada bagian KONFIGURASI di dalam kode.</p>
  <a class="btn" id="wa-link" href="#" target="_blank" rel="noopener">Hubungi WhatsApp</a>
  <a class="btn alt" id="discord-link" href="#" target="_blank" rel="noopener">Gabung Discord</a>
</section>
</main>

<footer>
  <div class="wrap">
    © <span id="year"></span> STOGRA STORE. All rights reserved.
    <br><br>Produk pada katalog awal adalah contoh. Pastikan detail dan harga sesuai produk yang benar-benar kamu jual.
  </div>
</footer>

<!-- DETAIL PRODUK -->
<div class="modal" id="detail-modal" onclick="backdropClose(event,'detail-modal')">
  <div class="modal-box">
    <button class="close" onclick="closeModal('detail-modal')">✕</button>
    <div id="detail-content"></div>
  </div>
</div>

<!-- KERANJANG -->
<div class="modal" id="cart-modal" onclick="backdropClose(event,'cart-modal')">
  <div class="modal-box">
    <button class="close" onclick="closeModal('cart-modal')">✕</button>
    <h2>🛒 Keranjang belanja</h2>
    <div id="cart-content"></div>
    <button class="btn" onclick="checkoutWhatsApp()">Lanjut melalui WhatsApp</button>
  </div>
</div>

<!-- STAFF AI -->
<div class="modal" id="ai-modal" onclick="backdropClose(event,'ai-modal')">
  <div class="modal-box">
    <button class="close" onclick="closeModal('ai-modal')">✕</button>
    <h2>✨ STOGRA Staff</h2>
    <p class="muted">Tanyakan tentang katalog dan cara menghubungi toko.</p>
    <div id="chat-log">
      <div class="chat-msg">Halo! Saya staff virtual STOGRA. Ada yang bisa saya bantu?</div>
    </div>
    <form onsubmit="sendChat(event)">
      <input class="field" id="chat-input" placeholder="Tulis pertanyaanmu..." required>
      <button class="btn" type="submit">Kirim →</button>
    </form>
    <p class="muted">Ini chatbot demo berbasis aturan, belum terhubung ke model AI online.</p>
  </div>
</div>

<script>
// ================= KONFIGURASI TOKO =================
// Ganti nomor berikut dengan nomor WhatsApp toko, format 62xxxxxxxxxx.
const WHATSAPP_NUMBER = "6281234567890";

// Ganti dengan undangan Discord milik tokomu.
const DISCORD_INVITE = "https://discord.com";

// ================= KATALOG PRODUK =================
// Edit nama, harga, kategori, ikon, dan deskripsi di sini.
const products = [
  {
    id:1,
    name:"Roblox Creator Kit",
    category:"Tools",
    price:25000,
    icon:"🧩",
    description:"Contoh paket aset dan panduan untuk membantu kreator memulai proyek Roblox."
  },
  {
    id:2,
    name:"Gaming UI Pack",
    category:"Tools",
    price:35000,
    icon:"🎨",
    description:"Contoh aset antarmuka untuk inspirasi dashboard dan proyek gaming."
  },
  {
    id:3,
    name:"Discord Server Setup",
    category:"Layanan",
    price:50000,
    icon:"💬",
    description:"Contoh layanan penataan channel dan role untuk komunitas gaming."
  },
  {
    id:4,
    name:"Gaming Starter Pack",
    category:"Game",
    price:40000,
    icon:"🎮",
    description:"Contoh paket digital untuk kebutuhan gaming. Ganti dengan produk asli toko."
  },
  {
    id:5,
    name:"Community Support",
    category:"Layanan",
    price:20000,
    icon:"🛠️",
    description:"Contoh layanan bantuan dan konsultasi komunitas."
  },
  {
    id:6,
    name:"Creator Resource Pack",
    category:"Tools",
    price:30000,
    icon:"⚡",
    description:"Contoh resource pack untuk membantu alur kerja kreator."
  }
];

let activeFilter = "Semua";
let cart = [];

function rupiah(n){
  return new Intl.NumberFormat("id-ID",{
    style:"currency",currency:"IDR",maximumFractionDigits:0
  }).format(n);
}

function renderProducts(){
  const query = document.getElementById("search").value.toLowerCase();
  const list = products.filter(p =>
    (activeFilter==="Semua" || p.category===activeFilter) &&
    (p.name.toLowerCase().includes(query) ||
     p.description.toLowerCase().includes(query))
  );

  const grid = document.getElementById("product-grid");

  if(!list.length){
    grid.innerHTML='<div class="empty">Produk tidak ditemukan.</div>';
    return;
  }

  grid.innerHTML = list.map(p => `
    <article class="card">
      <div class="art">${p.icon}</div>
      <div class="card-body">
        <span class="tag">${p.category}</span>
        <h3>${p.name}</h3>
        <div class="muted">${p.description}</div>
        <div class="price">${rupiah(p.price)}</div>
        <div class="card-actions">
          <button class="btn alt" onclick="showDetail(${p.id})">Detail</button>
          <button class="btn" onclick="addCart(${p.id})">+ Keranjang</button>
        </div>
      </div>
    </article>
  `).join("");
}

function setFilter(category,button){
  activeFilter=category;
  document.querySelectorAll(".filter").forEach(b=>b.classList.remove("active"));
  button.classList.add("active");
  renderProducts();
}

function showDetail(id){
  const p=products.find(x=>x.id===id);
  document.getElementById("detail-content").innerHTML=`
    <div class="art" style="border-radius:12px">${p.icon}</div>
    <p class="eyebrow">${p.category}</p>
    <h2>${p.name}</h2>
    <p class="muted">${p.description}</p>
    <div class="price">${rupiah(p.price)}</div>
    <button class="btn" onclick="addCart(${p.id});closeModal('detail-modal')">
      Tambahkan ke keranjang
    </button>`;
  openModal("detail-modal");
}

function addCart(id){
  const p=products.find(x=>x.id===id);
  const existing=cart.find(x=>x.id===id);
  if(existing) existing.qty++;
  else cart.push({...p,qty:1});
  updateCart();
}

function updateCart(){
  document.getElementById("cart-count").textContent=
    cart.reduce((sum,p)=>sum+p.qty,0);

  const total=cart.reduce((sum,p)=>sum+p.price*p.qty,0);
  const content=document.getElementById("cart-content");

  if(!cart.length){
    content.innerHTML='<div class="empty">Keranjangmu masih kosong.</div>';
    return;
  }

  content.innerHTML=cart.map(p=>`
    <div class="cart-line">
      <b>${p.icon} ${p.name}</b>
      <div class="muted">${p.qty} × ${rupiah(p.price)}</div>
      <button class="filter" onclick="removeCart(${p.id})">Hapus</button>
    </div>
  `).join("")+`<h3>Total: ${rupiah(total)}</h3>`;
}

function removeCart(id){
  cart=cart.filter(p=>p.id!==id);
  updateCart();
}

function checkoutWhatsApp(){
  if(!cart.length){
    alert("Keranjang masih kosong, bro!");
    return;
  }

  const lines=cart.map(p=>`${p.name} x${p.qty} — ${rupiah(p.price*p.qty)}`);
  const total=cart.reduce((sum,p)=>sum+p.price*p.qty,0);
  const message="Halo STOGRA STORE, saya ingin bertanya tentang pesanan:%0A"+
    encodeURIComponent(lines.join("\n"))+
    "%0A%0ATotal: "+encodeURIComponent(rupiah(total));

  window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${message}`,"_blank","noopener");
}

function openAI(){openModal("ai-modal")}
function openCart(){updateCart();openModal("cart-modal")}
function openModal(id){document.getElementById(id).classList.add("show")}
function closeModal(id){document.getElementById(id).classList.remove("show")}
function backdropClose(event,id){
  if(event.target.id===id) closeModal(id);
}

function sendChat(event){
  event.preventDefault();
  const input=document.getElementById("chat-input");
  const question=input.value.trim();
  if(!question)return;

  addMessage(question,"user");
  input.value="";

  const q=question.toLowerCase();
  let answer="Saya bisa membantu menjelaskan katalog. Coba tanyakan produk, harga, keranjang, atau cara menghubungi toko.";

  if(q.includes("harga")||q.includes("produk")||q.includes("katalog")){
    answer="Produk demo kami: "+products.map(p=>p.name+" ("+rupiah(p.price)+")").join(", ")+". Silakan cek katalog untuk detail. Harga ini perlu kamu sesuaikan dengan produk asli.";
  }else if(q.includes("bayar")||q.includes("pembayaran")||q.includes("payment")){
    answer="Pembayaran otomatis belum aktif. Untuk sementara, kamu bisa mengirim pertanyaan pesanan melalui WhatsApp toko.";
  }else if(q.includes("admin")||q.includes("staff")||q.includes("manusia")||q.includes("whatsapp")){
    answer="Untuk menghubungi staff, gunakan tombol WhatsApp di bagian Bantuan. Pastikan nomor WhatsApp di konfigurasi sudah diganti.";
  }else if(q.includes("discord")){
    answer="Kamu bisa menggunakan tombol Discord pada bagian Bantuan. Ganti tautannya dengan undangan server resmi tokomu.";
  }else if(q.includes("halo")||q.includes("hai")||q.includes("hello")){
    answer="Halo juga! Mau tanya soal produk, harga, atau cara menghubungi staff?";
  }

  setTimeout(()=>addMessage(answer,"bot"),250);
}

function addMessage(text,type){
  const log=document.getElementById("chat-log");
  const div=document.createElement("div");
  div.className="chat-msg"+(type==="user"?" user":"");
  div.textContent=text;
  log.appendChild(div);
  log.scrollTop=log.scrollHeight;
}

document.getElementById("year").textContent=new Date().getFullYear();
document.getElementById("wa-link").href="https://wa.me/"+WHATSAPP_NUMBER;
document.getElementById("discord-link").href=DISCORD_INVITE;
renderProducts();
updateCart();
</script>
</body>
</html>
